# Normalize text files
* text=auto

# Python
*.py text eol=lf

# Jupyter Notebooks
*.ipynb text eol=lf

# Markdown
*.md text eol=lf

# Configuration/data formats
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Git attributes file
.gitattributes text eol=lf